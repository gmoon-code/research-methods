{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Methods Studio AI Coach Response",
  "type": "object",
  "required": [
    "stage_id",
    "verdict",
    "summary",
    "diagnostics",
    "next_action",
    "source_status",
    "safety"
  ],
  "properties": {
    "stage_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18
    },
    "verdict": {
      "type": "string",
      "enum": [
        "not_ready",
        "needs_revision",
        "developing",
        "strong"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "severity",
          "finding",
          "why_it_matters",
          "student_task"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "finding": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "student_task": {
            "type": "string"
          },
          "evidence_from_student": {
            "type": "string"
          },
          "example_from_other_context": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "questions_for_student": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "source_status": {
      "type": "object",
      "required": [
        "used_external_sources",
        "claims_requiring_verification",
        "citations"
      ],
      "properties": {
        "used_external_sources": {
          "type": "boolean"
        },
        "claims_requiring_verification": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claim",
              "citation_label",
              "source_url",
              "verified"
            ],
            "properties": {
              "claim": {
                "type": "string"
              },
              "citation_label": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "clear",
            "teacher_review",
            "do_not_facilitate"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "prohibited_completion": {
      "type": "object",
      "required": [
        "did_not_replace_student_work",
        "did_not_invent_sources",
        "did_not_invent_data"
      ],
      "properties": {
        "did_not_replace_student_work": {
          "type": "boolean"
        },
        "did_not_invent_sources": {
          "type": "boolean"
        },
        "did_not_invent_data": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}