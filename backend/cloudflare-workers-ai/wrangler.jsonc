{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rms-research-chat-free",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "RMS_ALLOWED_ORIGINS": "https://gmoon-code.github.io",
    "RMS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "secrets": {
    "required": ["RMS_CHAT_ACCESS_CODE"]
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "215001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "215002",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "CLASS_RATE_LIMITER",
      "namespace_id": "215003",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
